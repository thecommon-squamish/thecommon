---
import Base from '../layouts/Base.astro';

const ROOMS = 'https://e-commerce.officernd.com/thecommon/search-results?type=meeting_room&listingType=resource';
---
<Base current="spaces" title="Meeting rooms — The Common Squamish" description="Find and book meeting rooms at The Common in downtown Squamish.">
  <header class="page-hd">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow on-dark">Meeting rooms</span>
      <h1>Room to <em class="shimmer">get together</em>.</h1>
      <p>Need a quiet space for a call or a room for a group? See available rooms and book online.</p>
    </div>
  </header>

  <section class="section light" id="rooms">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Reserve a room</span>
        <h2 class="section-title">Choose a room and time.</h2>
        <p class="intro">The booking system shows current availability and prices. Select what you need and complete your booking online.</p>
        <a class="btn btn-ink" href={ROOMS} target="_blank" rel="noopener noreferrer">See available rooms →</a>
      </div>
      <img class="photo" src="/img/common/photo-13.jpg" alt="Meeting area inside The Common" loading="lazy" />
    </div>
  </section>

  <section class="section warm" id="offices">
    <div class="wrap other-options">
      <div>
        <span class="eyebrow">Private offices and events</span>
        <h2 class="section-title">Need a different space?</h2>
        <p>Contact us about a private office or hosting an event.</p>
      </div>
      <a class="btn btn-outline" href="/contact/">Contact us →</a>
    </div>
  </section>
</Base>

<style>
  .section-title { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 1rem 0; }
  .intro, .other-options p { color: var(--stone); font-size: 1.08rem; margin-bottom: 1.6rem; }
  .other-options { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  @media (max-width: 700px) { .other-options { align-items: flex-start; flex-direction: column; } }
</style>
