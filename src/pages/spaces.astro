---
import Base from '../layouts/Base.astro';
const rooms = [
  { name:'Micro Office', type:'A room for one', text:'Close the door and get some focused work done. A compact private space for a call, a project, or a change of pace.', photo:'/img/approved/micro-office.jpg', alt:'The Micro Office at The Common', url:'https://e-commerce.officernd.com/thecommon/resources/685a4f6aeefbc2e8fa8b62ba' },
  { name:'Trailer', type:'Meet in the courtyard', text:'A small, character-filled space for a meeting or a stretch of focused work. Seats up to three.', photo:'/img/approved/trailer.jpg', alt:'Table and bench seating inside the Trailer', url:'https://e-commerce.officernd.com/thecommon/resources/685a4f6aeefbc2e8fa8b62aa' },
  { name:'Small Conference Room', type:'Bring the team together', text:'Space for a conversation, presentation, or team session. Seats up to six.', photo:'/img/approved/conference-room.jpg', alt:'The Small Conference Room at The Common', url:'https://e-commerce.officernd.com/thecommon/resources/685a4f6aeefbc2e8fa8b6292' },
];
---
<Base current="spaces" title="Book a room | The Common Squamish" description="Book the Micro Office, Trailer, or Small Conference Room at The Common in Squamish. Go directly to each room’s availability.">
  <header class="page-hd"><div class="wrap"><span class="eyebrow on-dark">Book a room</span><h1>Find the right room<br />for your day.</h1><p>Pick your space below, then choose a date and time in our booking system.</p></div></header>
  <section class="section light"><div class="wrap"><div class="rooms-intro"><h2>Three spaces, three ways to work.</h2><p>Every room has its own booking page, so you can go straight to availability.</p></div>
    <div class="room-list">{rooms.map((room) => <article class="room"><img src={room.photo} alt={room.alt} loading="lazy" /><div class="room-copy"><span class="kicker">{room.type}</span><h3>{room.name}</h3><p>{room.text}</p><a class="btn btn-primary" href={room.url} target="_blank" rel="noopener noreferrer">Check availability ↗</a></div></article>)}</div>
    <p class="system-note">Availability and current prices appear in the booking system. The indoor phone booth is for short calls and is not a bookable room.</p>
  </div></section>
  <section class="section warm"><div class="wrap other-options"><div><span class="kicker">Something different?</span><h2>Monthly office or a larger gathering?</h2><p>Tell us what you have in mind. We can help with private office and event inquiries.</p></div><a class="btn btn-secondary" href="/contact/">Ask us about the space ↗</a></div></section>
</Base>
<style>
  .rooms-intro{margin-bottom:2.5rem}.rooms-intro h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.04em;margin-bottom:.6rem}.rooms-intro p,.system-note,.other-options p{color:var(--muted)}.room-list{display:grid;gap:1.2rem}.room{display:grid;grid-template-columns:1fr 1fr;background:#fff;border:1px solid var(--line)}.room img{width:100%;height:100%;min-height:360px;object-fit:cover}.room-copy{display:flex;flex-direction:column;align-items:start;justify-content:center;padding:clamp(1.5rem,4vw,4rem)}.room-copy h3{font-size:clamp(2rem,3.5vw,3rem);letter-spacing:-.04em;margin:.5rem 0 1rem}.room-copy p{font-size:1.08rem;color:var(--muted);max-width:450px}.room-copy .btn{margin-top:1rem}.system-note{font-size:.92rem;margin:1.5rem 0 0}.other-options{display:flex;align-items:center;justify-content:space-between;gap:2rem}.other-options h2{font-size:clamp(1.9rem,3vw,3rem);margin:.5rem 0}.other-options p{margin:0}@media(max-width:750px){.room{grid-template-columns:1fr}.room img{height:auto;min-height:0;aspect-ratio:1.5}.room-copy{padding:1.5rem 1.4rem 2rem}.other-options{align-items:start;flex-direction:column}}
</style>
