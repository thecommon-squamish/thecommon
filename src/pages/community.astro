flex-wrap:wrap;gap:.8rem;margin:1.5rem 0 0}.program-link span{margin:0 .5rem;color:var(--muted)}@media(max-width:800px){.founding-grid{grid-template-columns:1fr}.founding-note{max-width:560px}.people-details{grid-template-columns:1fr 1fr}.community-grid,.program-grid,.feedback-grid{grid-template-columns:1fr}}@media(max-width:680px){.people-details{grid-template-columns:1fr}.founding-note{transform:rotate(.5deg);margin-right:15px}}</style>
