---
import Base from '../layouts/Base.astro';
// HubSpot 'Ask us anything' form, same portal + form as the current thecommon.io site.
const HUBSPOT_PORTAL = '4007228';
const HUBSPOT_FORM = '845c5505-46d2-4244-a0d2-ef7fb8345de9';
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const useOfficeRndForm = Boolean(contactEndpoint && turnstileSiteKey);
---
<Base current="contact" title="Contact | The Common Squamish" description="The Common is at 38016 Cleveland Avenue, downtown Squamish. Email welcome@thecommon.io or send us a note.">
  <header class="page-hd">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap">

      <h1>Get in <em class="shimmer">touch</em>.</h1>
      <p>Have a question about a desk, an office, or an event? Write to us. You'll find us on Cleveland Avenue in downtown Squamish.</p>
    </div>
  </header>

  <section class="section light">
    <div class="wrap contact-grid">
      <!-- details -->
      <div>

        <h2 class="serif" style="font-size:clamp(1.8rem,4vw,2.6rem);margin:1rem 0 1.4rem;">38016 Cleveland Avenue.</h2>
        <p class="c-row"><strong>Visit</strong><span>38016 Cleveland Avenue,<br>Squamish, BC</span></p>
        <p class="c-row"><strong>Email</strong><a href="mailto:welcome@thecommon.io">welcome@thecommon.io</a></p>
        <p class="c-row"><strong>Call</strong><a href="tel:+17789060405">(778) 906-0405</a></p>
        <div class="book-direct"><p>Ready to reserve a space? Book online.</p><div class="book-direct-actions"><a href="/spaces/">Book a room</a><a href="/day-pass/">Book a desk</a></div></div>
        <img class="photo" src="/img/story/storefront-clean.webp" alt="The Common storefront and evenly spaced sign on Cleveland Avenue" loading="lazy" style="margin-top:1.8rem;" />
        <div class="socials">
          <a href="https://www.instagram.com/thecommon.io/" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://www.facebook.com/thecommon.io/" target="_blank" rel="noopener noreferrer">Facebook</a>
          <a href="https://maps.google.com/?q=38016+Cleveland+Avenue,+Squamish,+BC" target="_blank" rel="noopener noreferrer">Directions</a>
        </div>
      </div>

      <!-- form -->
      <div class="form-card">
        <h3 class="serif">Tell us what you have in mind.</h3>
        <div class="form-intro"><p>Leave a note here or email us directly.</p><a href="mailto:welcome@thecommon.io">Email us directly</a></div>
        {useOfficeRndForm ? (
          <form id="contact-form" data-endpoint={contactEndpoint} novalidate>
            <label for="contact-name">Name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" autocomplete="name" maxlength="100" required />
            <label for="contact-email">Email <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
            <label for="contact-phone">Phone <span class="optional">optional</span></label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
            <label for="contact-interest">What can we help with? <span aria-hidden="true">*</span></label>
            <select id="contact-interest" name="interest" required>
              <option value="">Choose one</option>
              <option value="Desk or day pass">Desk or day pass</option>
              <option value="Bookable room">Bookable room</option>
              <option value="Private office">Private office</option>
              <option value="Membership">Membership</option>
              <option value="Event">Event</option>
              <option value="Something else">Something else</option>
            </select>
            <label for="contact-message">Your message <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="6" minlength="10" maxlength="4000" required></textarea>
            <div class="website-field" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
            <p id="contact-status" class="contact-status" role="status" aria-live="polite"></p>
            <button class="btn" type="submit">Send your message</button>
          </form>
        ) : (
          <div class="hbspt-form" id="hubspot-contact-form"></div>
        )}
        {useOfficeRndForm ? (
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        ) : (
          <>
            <script is:inline src="https://js.hsforms.net/forms/embed/v2.js"></script>
            <script is:inline define:vars={{ HUBSPOT_PORTAL, HUBSPOT_FORM }}>
              hbspt.forms.create({ portalId: HUBSPOT_PORTAL, formId: HUBSPOT_FORM, target: '#hubspot-contact-form' });
            </script>
          </>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const status = document.querySelector<HTMLElement>('#contact-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !status || !button) return;
      const values = Object.fromEntries(new FormData(form).entries());
      if (!values['cf-turnstile-response']) {
        status.textContent = 'Please complete the quick verification, then try again.';
        return;
      }
      button.disabled = true;
      status.textContent = 'Sending your message…';
      try {
        const response = await fetch(form.dataset.endpoint || '', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values),
        });
        if (!response.ok) throw new Error('Submission failed');
        form.reset();
        status.textContent = 'Thanks for writing. We have your message and will get back to you.';
      } catch {
        status.innerHTML = 'That did not go through. Please email <a href="mailto:welcome@thecommon.io">welcome@thecommon.io</a> instead.';
      } finally {
        button.disabled = false;
        const turnstile = (window as typeof window & { turnstile?: { reset: () => void } }).turnstile;
        turnstile?.reset();
      }
    });
  }
</script>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 3.5rem; align-items: start; }
  .contact-grid .photo{border-width:12px 12px 24px;transform:rotate(-1.4deg);box-shadow:14px 18px 0 #e1d5bf,0 25px 35px #203b2830}
  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }
  .c-row { display: flex; gap: 0.7rem; font-size: 1.05rem; color: var(--stone); margin-bottom: 0.9rem; align-items: flex-start; }.c-row strong{min-width:3.7rem;color:var(--forest);font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;padding-top:.1rem}.book-direct{margin-top:1.5rem;color:var(--muted)}.book-direct p{margin:0 0 .5rem}.book-direct-actions{display:flex;flex-wrap:wrap;gap:.8rem}.book-direct a{color:var(--forest);text-decoration:underline;text-underline-offset:3px;font-weight:700}
  .c-row a { text-decoration: underline; text-underline-offset: 3px; }
  .socials { display: flex; gap: 1.4rem; margin-top: 1.6rem; }
  .socials a { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .socials a:hover { text-decoration:underline; }

  .form-card { background: var(--white); border: 1px solid var(--line); padding: 2.2rem; }
  .form-card h3 { font-size: 1.5rem; margin-bottom: 1.4rem; }
  .form-intro { color: var(--stone); margin: -0.5rem 0 1.4rem; }.form-intro p{margin:0 0 .5rem}
  .form-intro a { text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
  #contact-form { display:grid; gap:.55rem; }
  #contact-form label { font-weight:700; color:var(--forest); margin-top:.55rem; }
  #contact-form .optional { font-weight:400; color:var(--muted); }
  #contact-form :is(input, select, textarea) { width:100%; border:1px solid #a8b3aa; border-radius:5px; background:#fff; color:var(--ink); padding:.75rem .85rem; font:inherit; }
  #contact-form :is(input, select, textarea):focus-visible { outline:3px solid #d2734f; outline-offset:2px; }
  #contact-form textarea { resize:vertical; }
  #contact-form .website-field { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  #contact-form .cf-turnstile { margin-top:1rem; }
  #contact-form .contact-status { min-height:1.5rem; margin:.25rem 0; color:var(--forest); }
  #contact-form button { justify-self:start; }
  #contact-form button:disabled { opacity:.6; cursor:wait; }
</style>
