---
import Base from '../layouts/Base.astro';
import PrivateOfficeFeature from '../components/PrivateOfficeFeature.astro';

const MEMBERSHIPS = 'https://e-commerce.officernd.com/thecommon/search-results?type=hotdesk&listingType=plan';
const plans = [
  { days: '6 days / month', price: '$195', name: 'Flexi' },
  { days: '10 days / month', price: '$295', name: 'Flexi' },
  { days: '15 days / month', price: '$395', name: 'Flexi' },
  { days: '24/7 access', price: '$495', name: 'Full-time' },
];
---
<Base current="membership" title="Coworking memberships and private offices | The Common Squamish" description="Choose a coworking membership or ask about monthly private office availability at The Common in downtown Squamish.">
  <header class="page-hd">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow on-dark">Monthly memberships</span>
      <h1>Work here <em class="shimmer">regularly</em>.</h1>
      <p>Some weeks you need a desk every day. Some weeks you don't. Pick a monthly plan that fits your working life. Desk memberships have a three-month minimum.</p>
    </div>
  </header>

  <section class="section light">
    <div class="wrap">
      <div class="membership-intro"><img src="/img/approved/main-workspace.jpg" alt="People working together in The Common" loading="lazy" /><div><span class="eyebrow">Your monthly desk</span><h2>A familiar place to land.</h2><p>Come in on the days in your plan, plug into a monitor, and get to know the people who keep showing up beside you.</p></div></div>
      <div class="plan-heading">
        <h2>Monthly desk plans</h2>
        <p>Choose the number of days you'll actually use. Plans are billed monthly with a three-month minimum.</p>
      </div>
      <div class="plan-list">
        {plans.map((plan) => (
          <div class="plan-row">
            <div><span class="plan-name">{plan.name}</span><h3>{plan.days}</h3></div>
            <p>{plan.price}<span> / month</span></p>
          </div>
        ))}
      </div>
      <a class="btn btn-ink plan-action" href={MEMBERSHIPS} target="_blank" rel="noopener noreferrer">Request a membership</a>
      <p class="plan-note">Choose a plan and send a request. We'll confirm it before your membership starts.</p>
    </div>
  </section>

  <PrivateOfficeFeature photo="/img/story/private-office-side-view.jpg" />

  <section class="section light">
    <div class="wrap other-options">
      <div>
        <span class="eyebrow">Try us first</span>
        <h2>Come try a day first.</h2>
        <p>Work here for a few hours or a full day before you choose a plan.</p>
      </div>
      <a class="btn btn-outline" href="/day-pass/">See desk options</a>
    </div>
  </section>
</Base>

<style>
  .membership-intro{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2rem,5vw,5rem);align-items:center;margin-bottom:4rem}.membership-intro img{width:100%;aspect-ratio:1.6;object-fit:cover}.membership-intro h2{font-size:clamp(2.2rem,4vw,3.6rem);letter-spacing:-.04em;margin:.7rem 0}.membership-intro p{color:var(--muted);font-size:1.08rem}
  .membership-intro img{border:9px solid #fff;box-shadow:17px 17px 0 #d6cbb7,0 22px 34px #192c1e30;transform:rotate(-1deg)}
  .plan-heading { text-align: center; margin: 0 auto 2.2rem; }
  .plan-heading h2, .other-options h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; }
  .plan-heading p, .other-options p { font-size: 1.08rem; color: var(--stone); margin-top: 0.8rem; }
  .plan-list { max-width: 760px; margin: 0 auto 2rem; border: 1px solid var(--line); overflow: hidden; background: var(--white); }
  .plan-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.3rem 1.6rem; }
  .plan-row + .plan-row { border-top: 1px solid var(--line); }
  .plan-name { display: block; font-size: 0.72rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.12em; }
  .plan-row h3 { font-size: 1.35rem; line-height: 1.2; }
  .plan-row p { flex: none; font-family: var(--serif); font-size: 1.4rem; }
  .plan-row p span { font-family: var(--sans); font-size: 0.85rem; color: var(--stone-soft); }
  .plan-action { display: flex; width: fit-content; max-width: 100%; margin: 0 auto; white-space: normal; text-align: center; }
  .plan-note { text-align: center; margin-top: 0.9rem; color: var(--stone-soft); font-size: 0.9rem; }
  .other-options { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .other-options h2 { margin-top: 0.8rem; }
  @media (max-width: 700px) { .membership-intro{grid-template-columns:1fr}.other-options { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 420px) { .plan-row { align-items: flex-start; flex-direction: column; gap: 0.5rem; } }
</style>
