---
import Base from '../layouts/Base.astro';
---
<Base current="home" title="The Common — Coworking in Squamish" description="Book a day pass or hourly desk, explore memberships, and work from The Common in downtown Squamish.">
  <header class="hero">
    <img class="hero-img" src="/img/common/hero-working.jpg" alt="People working at desks inside The Common in Squamish" width="1844" height="853" fetchpriority="high" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <span class="eyebrow on-dark">Coworking in downtown Squamish</span>
      <h1>A good place to <em>get to work</em>.</h1>
      <p>Need a desk today or a regular place to work? Choose what fits and book online.</p>
      <div class="hero-actions">
        <a class="btn btn-gold" href="/day-pass/">Book a desk</a>
        <a class="btn btn-glass" href="/membership/">See memberships</a>
      </div>
    </div>
  </header>

  <section class="section light">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Choose your next step</span>
        <h2>How would you like to <em>work here?</em></h2>
      </div>
      <div class="choices">
        <a class="choice" href="/day-pass/">
          <span class="choice-number">01</span>
          <h3>Just visiting</h3>
          <p>Choose a $37 day pass or a desk from $6.50 an hour. No membership needed.</p>
          <strong>View desk options →</strong>
        </a>
        <a class="choice" href="/membership/">
          <span class="choice-number">02</span>
          <h3>Working here regularly</h3>
          <p>See flexible monthly plans and full-time membership options.</p>
          <strong>View memberships →</strong>
        </a>
      </div>
      <p class="rooms-link">Need a space for a meeting? <a href="/spaces/">See meeting rooms →</a></p>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap about-strip">
      <img src="/img/common/photo-2.jpg" alt="Desks and plants at The Common" loading="lazy" />
      <div>
        <span class="eyebrow">The Common</span>
        <h2>Work better, together.</h2>
        <p>A welcoming place to work in downtown Squamish, with desks, meeting rooms, coffee, and people to connect with.</p>
        <a class="text-link" href="/about/">Get to know The Common →</a>
      </div>
    </div>
  </section>

  <section class="section light">
    <div class="wrap contact-strip">
      <div>
        <span class="eyebrow">Visit us</span>
        <h2>Find us on Cleveland Avenue.</h2>
        <p>38016 Cleveland Avenue, Squamish, BC</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-ink" href="/contact/">Contact us</a>
        <a class="text-link" href="https://maps.google.com/?q=38016+Cleveland+Avenue,+Squamish,+BC" target="_blank" rel="noopener noreferrer">Get directions →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: 78vh; display: flex; align-items: center; overflow: hidden; padding: 150px 0 80px; background: var(--ink-deep); }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12,10,9,0.83), rgba(12,10,9,0.28)); }
  .hero-content { position: relative; z-index: 1; width: 100%; }
  .hero h1 { color: var(--white); max-width: 700px; font-size: clamp(2.7rem, 7vw, 5.2rem); line-height: 1.05; margin: 1.2rem 0; }
  .hero h1 em { color: var(--gold-glow); font-weight: 400; }
  .hero p { color: var(--white); font-size: clamp(1.1rem, 2vw, 1.3rem); max-width: 520px; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .choice { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.6rem, 4vw, 3rem); min-height: 280px; background: var(--white); border: 1px solid var(--line); border-radius: 20px; transition: border-color 0.2s, transform 0.2s; }
  .choice:hover { border-color: var(--gold); transform: translateY(-3px); }
  .choice-number { font-size: 0.8rem; color: var(--accent); letter-spacing: 0.12em; }
  .choice h3 { font-size: clamp(1.7rem, 3vw, 2.2rem); line-height: 1.1; margin: 0.8rem 0; }
  .choice p { color: var(--stone); font-size: 1.05rem; max-width: 370px; margin-bottom: 1.5rem; }
  .choice strong { margin-top: auto; font-size: 0.9rem; color: var(--accent); }
  .rooms-link { margin-top: 2rem; text-align: center; color: var(--stone); }
  .rooms-link a, .text-link { text-decoration: underline; text-underline-offset: 4px; font-weight: 500; }
  .about-strip { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .about-strip img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 18px; }
  .about-strip h2, .contact-strip h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 1rem 0; }
  .about-strip p, .contact-strip p { color: var(--stone); font-size: 1.08rem; margin-bottom: 1.3rem; }
  .contact-strip { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .contact-actions { display: flex; align-items: center; gap: 1.3rem; flex-wrap: wrap; }
  @media (max-width: 760px) { .hero-img { object-position: 68% center; } .choices, .about-strip { grid-template-columns: 1fr; } .contact-strip { align-items: flex-start; flex-direction: column; } }
</style>
