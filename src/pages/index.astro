---
import Base from '../layouts/Base.astro';
const ROOMS = 'https://e-commerce.officernd.com/thecommon/search-results?type=meeting_room&listingType=resource';
---
<Base current="home" title="The Common | Coworking and bookable rooms in Squamish" description="Find a desk, book a private room, or make The Common your regular workspace in downtown Squamish.">
  <header class="home-hero">
    <div class="hero-copy">
      <span class="kicker">The Common · Downtown Squamish</span>
      <h1>Connecting people.<br /><em>Creating community.</em></h1>
      <p>Find your place to work in Squamish. Book a desk for an hour or a day, meet in a private room, or settle in for the month.</p>
      <div class="hero-buttons"><a class="btn btn-primary" href="/spaces/">Book a room</a><a class="btn btn-secondary" href="/day-pass/">Book a desk</a></div>
      <p class="booking-note">Choose a space and see current availability and prices online.</p>
    </div>
    <div class="hero-picture"><img src="/img/approved/hero-wide-working.jpg" alt="Wide view of The Common workspace with people working at the desks" width="1448" height="1086" fetchpriority="high" /></div>
  </header>

  <section class="booking-section" id="book"><div class="wrap">
    <div class="section-heading"><div><span class="kicker">Book your space</span><h2>What do you need today?</h2></div><p>Find a desk, a private room, a monthly plan, or a place for your next event.</p></div>
    <div class="booking-routes">
      <a class="booking-route" href="/spaces/"><img src="/img/approved/conference-room.jpg" alt="Small Conference Room at The Common" loading="lazy" /><span class="route-body"><span class="route-label">Private space</span><strong>Book a room</strong><span>Micro Office, Trailer, or Small Conference Room</span><b>See the rooms</b></span></a>
      <a class="booking-route" href="/day-pass/"><img src="/img/approved/hot-desks.jpg" alt="Shared desks at The Common" loading="lazy" /><span class="route-body"><span class="route-label">A few hours or a day</span><strong>Book a desk</strong><span>Work here without a membership</span><b>See desk options</b></span></a>
      <a class="booking-route" href="/membership/"><img src="/img/approved/private-office.jpg" alt="Private office at The Common" loading="lazy" /><span class="route-body"><span class="route-label">Work here regularly</span><strong>Memberships & offices</strong><span>Monthly desk plans and private offices</span><b>See memberships</b></span></a>
      <a class="booking-route" href="/event-space/"><img src="/img/story/common-event-buffet.jpg" alt="Guests talking over food at a gathering inside The Common" loading="lazy" /><span class="route-body"><span class="route-label">For a group</span><strong>Events & gatherings</strong><span>Meetups, workshops, and community events</span><b>Plan an event</b></span></a>
    </div>
    <p class="booking-assist">Already know which room you want? <a href={ROOMS} target="_blank" rel="noopener noreferrer">Check availability</a> &nbsp; First visit? <a href="/faq/">Read the FAQs</a></p>
  </div></section>

  <section class="squamish-band" aria-label="Squamish landscape"><img src="/img/common/squamish-from-dev.jpg" alt="The Stawamus Chief, mountains, and Howe Sound above Squamish" loading="lazy" /><div class="wrap squamish-caption"><span class="kicker">Our town</span><p>Work in downtown Squamish. Find your people here.</p><a href="/about/">Get to know The Common <span aria-hidden="true">↗</span></a></div></section>

  <section class="home-story"><div class="wrap story-grid"><div class="story-photo"><img src="/img/story/back-desks-ready.webp" alt="Warm, ready-to-use workstations in The Common's main room" loading="lazy" /></div><div class="story-copy"><span class="kicker">Work together. Grow together.</span><h2>A workspace with neighbours.</h2><p>People come here to get work done. They also meet the people working at the next desk, share lunch, and hear what others in Squamish are building.</p><p>That was the idea when The Common opened on Cleveland Avenue in 2017. It still shapes the place today.</p><a class="inline-link" href="/about/">Read our story</a></div></div></section>

  <section class="tour-section"><div class="wrap"><div class="tour-heading"><div><span class="kicker">Take a look around</span><h2>Walk through The Common.</h2></div><p>Start at the front door and see the desks, rooms, kitchen, and courtyard.</p></div><video data-scroll-play controls muted playsinline preload="metadata" poster="/img/approved/main-workspace.jpg" aria-label="Video tour of The Common coworking space"><source src="/video/the-common-walkthrough.mp4" type="video/mp4" />Your browser does not support video. <a href="/video/the-common-walkthrough.mp4">Open the tour video</a>.</video><p class="tour-sound">The tour starts as you scroll. Use the controls to pause or replay it.</p></div></section>

  <section class="day-in-space"><div class="wrap day-grid"><div><span class="kicker">Inside The Common</span><h2>Everything you need for a workday.</h2><p>Desks have monitors. There is a kitchen for lunch, a courtyard for fresh air, and an indoor phone booth for short calls.</p><a class="inline-link" href="/spaces/">See the rooms</a></div><img src="/img/approved/courtyard.jpg" alt="Outdoor seating area at The Common" loading="lazy" /></div></section>

  <section class="first-visit"><div class="wrap first-visit-inner"><div><span class="kicker">Your first visit</span><h2>Coming in for the first time?</h2><p>Book online and check your welcome email for access details. Our FAQs cover calls, dogs, the kitchen, and where to find us.</p></div><a class="btn btn-secondary" href="/faq/">Read the FAQs</a></div></section>

  <section class="visit-bar"><div class="wrap visit-grid"><div><span class="kicker">Come find us</span><h2>On Cleveland Avenue.</h2><p>38016 Cleveland Avenue, Squamish, BC</p></div><div class="visit-actions"><a class="btn btn-primary" href="/spaces/">Find a room</a><a class="inline-link" href="https://maps.google.com/?q=38016+Cleveland+Avenue,+Squamish,+BC" target="_blank" rel="noopener noreferrer">Get directions</a></div></div></section>
</Base>

<script>
  const tour = document.querySelector<HTMLVideoElement>('[data-scroll-play]');
  if (tour && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) tour.play().catch(() => {});
      else tour.pause();
    }, { threshold: 0.45 });
    observer.observe(tour);
  }
</script>

<style>
  .home-hero{position:relative;min-height:min(850px,90vh);display:flex;align-items:end;isolation:isolate;overflow:hidden;background:#192823;color:#fff;padding:clamp(9rem,15vw,13rem) 0 clamp(3.4rem,6vw,6rem)}.home-hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(11,24,21,.78),rgba(11,24,21,.43) 52%,rgba(11,24,21,.03) 87%),linear-gradient(0deg,rgba(11,24,21,.33),transparent 48%)}.hero-copy{width:min(100% - 3rem,1340px);margin:0 auto;position:relative;z-index:1}.hero-copy .kicker{color:#f8dac7}.hero-copy h1{font-size:clamp(3.35rem,6.1vw,6.5rem);line-height:.99;margin:1.15rem 0 1.45rem;letter-spacing:-.055em;max-width:1000px;text-wrap:balance}.hero-copy h1 em{font-style:normal;color:#f3d6bd}.hero-copy>p:not(.booking-note){font-size:clamp(1.08rem,1.55vw,1.3rem);max-width:590px;line-height:1.5;margin:0}.hero-buttons{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.8rem}.hero-buttons .btn-primary{background:#fff;color:var(--forest)}.hero-buttons .btn-secondary{border-color:#fff;color:#fff;background:rgba(12,28,22,.18)}.booking-note{font-size:.88rem;color:#f3ede5;margin:1rem 0 0}.hero-picture{position:absolute;inset:0;z-index:-2;overflow:hidden}.hero-picture img{width:100%;height:100%;object-fit:cover;object-position:center top;position:absolute;inset:0}
  .booking-section{padding:6rem 0 5rem;background:var(--paper)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2rem}.section-heading h2,.story-copy h2,.day-grid h2,.visit-grid h2{font-size:clamp(2.4rem,4vw,4.1rem);line-height:1.05;letter-spacing:-.045em;margin:.65rem 0 0}.section-heading p{max-width:390px;color:var(--muted);font-size:1.03rem}.booking-routes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.2rem}.booking-route{display:flex;flex-direction:column;border-top:2px solid var(--ink);transition:color .2s}.booking-route:hover{color:var(--forest)}.booking-route img{width:100%;aspect-ratio:1.15;object-fit:cover;margin-top:1rem;transition:filter .25s}.booking-route:hover img{filter:saturate(1.12)}.route-body{display:flex;flex-direction:column;padding:1.15rem 0 0;min-height:205px}.route-label{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:var(--forest);font-weight:700}.route-body strong{font-family:var(--display);font-size:1.5rem;line-height:1.15;margin:.45rem 0;font-weight:700}.route-body>span:nth-child(3){color:var(--muted);line-height:1.4}.route-body b{margin-top:auto;padding-top:1rem;color:var(--forest);font-size:.9rem;text-decoration:underline;text-underline-offset:4px}.booking-assist{margin-top:2rem;color:var(--muted);font-size:.94rem}.booking-assist a{text-decoration:underline;text-underline-offset:4px;color:var(--forest);font-weight:700}
  .squamish-band{min-height:600px;height:min(78vw,850px);position:relative;overflow:hidden;background:#1c2d2f}.squamish-band:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.62),rgba(0,0,0,.12) 58%,transparent 85%),linear-gradient(0deg,rgba(0,0,0,.34),transparent 45%)}.squamish-band img{width:100%;height:100%;object-fit:cover;object-position:center 28%}.squamish-caption{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;justify-content:end;padding-bottom:clamp(3rem,7vw,6rem);color:#fff}.squamish-caption .kicker{color:#ffe2cb}.squamish-caption p{font-size:clamp(2.2rem,5vw,5.3rem);font-weight:700;letter-spacing:-.055em;line-height:1.03;max-width:790px;margin:.65rem 0 1.4rem;text-wrap:balance}.squamish-caption a{width:fit-content;color:#fff;border-bottom:2px solid #fff;padding-bottom:.25rem;font-weight:700}.squamish-caption a:hover{color:#ffe2cb}.first-visit{padding:3.5rem 0;background:#f2e9df}.first-visit-inner{display:flex;align-items:center;justify-content:space-between;gap:2rem}.first-visit h2{font-size:clamp(2rem,3vw,3rem);letter-spacing:-.04em;margin:.5rem 0}.first-visit p{max-width:660px;color:var(--muted);margin:0}
  .home-story{padding:6rem 0;background:#e9e9df}.story-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(2rem,6vw,6rem);align-items:center}.story-photo{margin-left:max(-4vw,-90px)}.story-photo img{width:100%;aspect-ratio:1.18;object-fit:cover}.story-copy p{font-size:1.08rem;color:var(--muted);margin:1.4rem 0;max-width:530px}.story-copy h2{max-width:550px}.day-in-space{padding:6rem 0;background:var(--paper)}.day-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,6vw,6rem);align-items:center}.day-grid p{max-width:460px;color:var(--muted);font-size:1.08rem;margin:1.4rem 0}.day-grid img{width:100%;aspect-ratio:1.45;object-fit:cover}.visit-bar{background:var(--forest);color:#fff;padding:4rem 0}.visit-grid{display:flex;justify-content:space-between;align-items:center;gap:2rem}.visit-grid p{margin:.9rem 0 0}.visit-actions{display:flex;align-items:center;gap:1.6rem}.visit-actions .btn-primary{background:#fff;color:var(--forest)}.visit-actions .inline-link{color:#fff}
  .tour-section{padding:5rem 0;background:#e9e9df}.tour-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:1.5rem}.tour-heading h2{font-size:clamp(2.2rem,4vw,3.6rem);letter-spacing:-.045em;margin:.6rem 0 0}.tour-heading p{max-width:350px;color:var(--muted)}.tour-section video{display:block;width:100%;aspect-ratio:16/9;background:#142b20;object-fit:cover;max-height:680px}.tour-sound{font-size:.85rem;color:var(--muted);margin:.7rem 0 0}
  @media(max-width:850px){.home-hero{min-height:690px;padding:10rem 0 3rem}.home-hero:after{background:linear-gradient(0deg,rgba(11,24,21,.88),rgba(11,24,21,.37) 62%,rgba(11,24,21,.08))}.hero-copy{width:min(100% - 2.7rem,700px)}.hero-picture img{object-position:54% center}.booking-routes{grid-template-columns:1fr 1fr}.booking-route{display:block}.booking-route img{height:auto;aspect-ratio:1.45}.section-heading,.visit-grid,.tour-heading,.first-visit-inner{align-items:start;flex-direction:column}.story-grid,.day-grid{grid-template-columns:1fr}.story-photo{margin-left:0}.day-grid img{order:-1}}@media(max-width:560px){.home-hero{min-height:690px;padding-bottom:3.2rem}.hero-copy h1{font-size:clamp(3rem,11vw,4.3rem)}.hero-copy>p:not(.booking-note){font-size:1.05rem}.booking-section,.home-story,.day-in-space,.tour-section{padding:4rem 0}.booking-routes{grid-template-columns:1fr}.booking-route img{aspect-ratio:1.6}.route-body{min-height:0}.route-body b{padding-top:.8rem}.visit-actions{flex-wrap:wrap}.squamish-band{height:540px;min-height:0}.squamish-band img{object-position:39% center}.squamish-caption p{font-size:clamp(2.4rem,9vw,3.5rem)}.squamish-band:after{background:linear-gradient(0deg,rgba(0,0,0,.7),rgba(0,0,0,.1) 80%)}}
</style>
