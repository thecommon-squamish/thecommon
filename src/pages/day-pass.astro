---
import Base from '../layouts/Base.astro';

const DAY_PASS = 'https://e-commerce.officernd.com/thecommon/plans/685a4f6beefbc2e8fa8b62f4';
const HOURLY_DESK = 'https://e-commerce.officernd.com/thecommon/resources/685a4f6aeefbc2e8fa8b62ce';
---
<Base current="day-pass" title="Book a desk | The Common Squamish" description="Book a coworking desk in Squamish. Choose a $37 day pass or an hourly desk from $6.50 per hour.">
  <header class="page-hd">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap">

      <h1>Book a <em class="shimmer">desk</em>.</h1>
      <p>Need to get out of the home office? Come in for a few hours or stay for the day. You don't need a membership.</p>
    </div>
  </header>

  <section class="section light">
    <div class="wrap">
      <div class="desk-intro"><div><h2>Find your focus here.</h2><p>Set up in the shared space with a monitor at your desk. Make lunch in the kitchen or take five minutes in the courtyard when you need a break.</p></div><img src="/img/story/window-desks-ready.webp" alt="Ready-to-use desks beside The Common's front windows and wall logo" loading="lazy" /></div>
      <div class="booking-grid">
        <article class="booking-card">

          <h2>Day pass</h2>
          <p class="price">$37 <span>/ day, plus tax</span></p>
          <p>Work here Monday to Friday, 6 a.m. to 6 p.m. Choose a date and pay online.</p>
          <a class="btn btn-ink" href={DAY_PASS} target="_blank" rel="noopener noreferrer">Buy a day pass</a>
        </article>
        <article class="booking-card">

          <h2>Hourly desk</h2>
          <p class="price">$6.50 <span>/ hour, plus tax</span></p>
          <p>Choose a date and time, then book your desk online.</p>
          <a class="btn btn-ink" href={HOURLY_DESK} target="_blank" rel="noopener noreferrer">Book an hourly desk</a>
        </article>
      </div>
      <div class="help"><p>Booking opens in The Common's booking system. Need a day pass outside those hours?</p><a href="/contact/">Contact us</a></div>
    </div>
  </section>

  <section class="section warm">
    <div class="wrap next-step">
      <div>

        <h2>Starting to feel at home?</h2>
        <p>If you're coming in most weeks, have a look at the monthly desk plans.</p>
      </div>
      <a class="btn btn-outline" href="/membership/">View memberships</a>
    </div>
  </section>
</Base>

<style>
  .desk-intro{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,5vw,5rem);align-items:center;margin-bottom:3rem}.desk-intro h2{font-size:clamp(2.2rem,4vw,3.6rem);letter-spacing:-.04em;margin:.7rem 0}.desk-intro p{color:var(--muted);font-size:1.08rem}.desk-intro img{width:100%;aspect-ratio:1.6;object-fit:cover}
  .desk-intro img{border:12px solid #fdfbf6;box-shadow:-20px 20px 0 #d7dfd4,0 22px 40px #22322826;transform:rotate(1deg)}
  .booking-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .booking-card { display: flex; flex-direction: column; align-items: flex-start; background: var(--white); border: 1px solid var(--line); padding: clamp(1.6rem, 4vw, 3rem); }
  .booking-card h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 1rem 0; }
  .booking-card p:not(.price) { font-size: 1.05rem; color: var(--stone); margin-bottom: 2rem; }
  .booking-card .price { font-family: var(--serif); font-size: 2rem; line-height: 1.2; margin-bottom: 0.9rem; }
  .booking-card .price span { font-family: var(--sans); font-size: 0.95rem; color: var(--stone-soft); }
  .booking-card .btn { margin-top: auto; white-space: normal; text-align: center; }
  .help { text-align: center; margin-top: 1.8rem; color: var(--stone); }
  .help a { text-decoration: underline; text-underline-offset: 3px; }
  .next-step { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .next-step h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.7rem 0; }
  .next-step p { color: var(--stone); }
  @media (max-width: 760px) { .desk-intro,.booking-grid { grid-template-columns: 1fr; } .next-step { align-items: flex-start; flex-direction: column; } }
</style>
