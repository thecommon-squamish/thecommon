---
import Base from '../layouts/Base.astro';
const questions = [
  { q: 'How do I book a desk or room?', a: 'Pick a desk or one of our three bookable rooms here. The booking button takes you to our booking system, where you can see what is free, choose your time, and pay or send a request.' },
  { q: 'How do I get into the building?', a: 'Look for our welcome email after your booking is confirmed. It has the details for finding us and getting through the door. Some bookings need approval first. If the email has not arrived, get in touch before you come down.' },
  { q: 'Can I take a call at a hot desk?', a: 'A quick, quiet call is fine. For a conversation that needs more time or privacy, use the indoor phone booth if it is free, or book a room. We all share the main workspace, so please keep it comfortable for the next person.' },
  { q: 'Is the phone booth bookable?', a: 'The indoor phone booth is for short, unscheduled calls. The Micro Office, Trailer, and Small Conference Room are the spaces you can reserve online.' },
  { q: 'Can I bring my dog?', a: 'We love dogs. Please check with us before bringing yours, keep them settled beside your desk, and clean up after them. The courtyard has artificial turf, so please check it before you leave too.' },
  { q: 'Is there somewhere to eat or take a break?', a: 'Yes. Bring your lunch, store it in the kitchen, and take a seat at the communal table. When the weather is good, the courtyard is there too.' },
  { q: 'Where do I find my bookings and invoices?', a: 'Your reservations, invoices, and space guides are available in The Common’s member portal after you create a booking.' },
];
---
<Base current="faq" title="Visiting The Common | FAQs" description="Find out how to book, enter, take calls, bring a dog, and use the kitchen and courtyard at The Common in Squamish.">
  <header class="page-hd"><div class="wrap"><h1>Good to know before your first day.</h1><p>How to get in, where to take a call, whether your dog can come, and the other things people ask us.</p></div></header>
  <section class="section light"><div class="wrap faq-layout"><div><h2>38016 Cleveland Avenue.</h2><p>We're in downtown Squamish. You can see current prices and availability when you book online.</p><div class="faq-booking-actions"><a class="btn btn-primary" href="/spaces/">Book a room</a><a class="btn btn-secondary" href="/day-pass/">Book a desk</a></div></div><div class="faq-list">{questions.map(({q,a}) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
  <section class="section warm"><div class="wrap faq-end"><div><h2>Ask us.</h2><p>Not sure which room fits, or can't find your arrival email? Send us a note and we'll help.</p></div><a class="btn btn-secondary" href="/contact/">Contact us</a></div></section>
</Base>
<style>.faq-layout{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(2rem,6vw,6rem)}.faq-layout h2,.faq-end h2{font-size:clamp(2rem,3.5vw,3.2rem);letter-spacing:-.04em;margin:.65rem 0 1rem}.faq-layout p,.faq-end p{color:var(--muted)}.desk-link{display:block;color:var(--forest);font-weight:700;text-decoration:underline;text-underline-offset:4px;margin-top:1rem}.faq-list{border-top:1px solid var(--line)}.faq-list details{border-bottom:1px solid var(--line);padding:1.2rem 0}.faq-list summary{cursor:pointer;font-size:1.16rem;font-weight:700;line-height:1.35;padding-right:2rem}.faq-list details p{margin:.9rem 0 0;max-width:650px}.faq-end{display:flex;justify-content:space-between;align-items:center;gap:2rem}.faq-end p{margin:0}@media(max-width:760px){.faq-layout{grid-template-columns:1fr}.faq-end{align-items:start;flex-direction:column}}</style>
