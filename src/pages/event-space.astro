---
import Base from '../layouts/Base.astro';
---
<Base current="event-space" title="Events at The Common | Squamish" description="Host a gathering, workshop, or community event at The Common in downtown Squamish. Tell us what you are planning.">
  <header class="page-hd"><div class="wrap"><span class="eyebrow on-dark">Events at The Common</span><h1>Bring your group<br />to The Common.</h1><p>We host workshops, meetups, and community events in downtown Squamish.</p></div></header>

  <section class="section light event-intro">
    <div class="wrap event-showcase">
      <div class="event-copy">
        <span class="kicker">Plan an event</span>
        <h2>Make room for something good.</h2>
        <p>Bring people together for a talk, a film, a workshop, or a night to catch up. The main room, kitchen, and courtyard can all be part of the plan.</p>
        <p>Send us your preferred date, the number of people, and a short description. We'll confirm the layout, timing, equipment, and price with you.</p>
        <a class="btn btn-primary" href="mailto:welcome@thecommon.io?subject=Event%20at%20The%20Common">Email us about an event</a>
      </div>
      <div class="event-feature"><img src="/img/story/common-event-gathering.jpg" alt="Guests talking together at an event inside The Common" loading="lazy" /></div>
    </div>
  </section>

  <section class="section warm past-events">
    <div class="wrap">
      <div class="past-heading"><h2>Good things have happened here.</h2></div>
      <div class="event-wall">
        <div class="event-print event-print--talk"><img src="/img/story/common-panel-talk.jpg" alt="Members gathered for a group discussion at The Common" loading="lazy" /></div>
        <div class="event-print event-print--movie"><img src="/img/story/common-movie-night.jpg" alt="A movie night at The Common" loading="lazy" /></div>
        <div class="event-print event-print--buffet"><img src="/img/story/common-event-buffet.jpg" alt="Members talking over food at a gathering" loading="lazy" /></div>
        <div class="event-print event-print--dinner"><img src="/img/story/common-social-dinner.jpg" alt="Members sharing dinner around a table" loading="lazy" /></div>
        <div class="event-print event-print--detail"><img src="/img/story/common-talk-detail.jpg" alt="Coffee and reading material during a gathering" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section light"><div class="wrap event-grid"><article><span class="kicker">Smaller meetings</span><h2>Book a room online.</h2><p>The Small Conference Room, Trailer, and Micro Office each have their own booking page.</p><a class="inline-link" href="/spaces/">See the rooms</a></article><article><span class="kicker">Community groups</span><h2>Planning a local event?</h2><p>The Common has supported nonprofit and community gatherings. Tell us what you're organizing and we'll let you know what is possible.</p><a class="inline-link" href="/community/">Read about our community work</a></article></div></section>
</Base>

<style>
  .event-showcase{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(2rem,5vw,5rem);align-items:center}
  .event-copy h2,.past-heading h2,.event-grid h2{font-size:clamp(2rem,3.5vw,3.2rem);letter-spacing:-.04em;margin:.7rem 0 1rem}
  .event-copy p,.event-grid p,.past-heading p{color:var(--muted);font-size:1.06rem}
  .event-copy .btn{margin-top:.6rem}
  .event-feature{margin:0 -4vw 0 0;padding:1rem;background:#e6d9c9;transform:rotate(1.3deg);box-shadow:18px 20px 0 rgba(36,84,62,.13)}
  .event-feature img{display:block;width:100%;height:540px;object-fit:cover;object-position:52% center}
  .past-events{overflow:hidden;background:#dfd2ba;position:relative}
  .past-events:before{content:"";position:absolute;inset:0;background:radial-gradient(#8b775b24 .8px,transparent 1px) 0 0/7px 7px;pointer-events:none}
  .past-heading{position:relative;margin-bottom:1.2rem}
  .event-wall{position:relative;height:760px;max-width:1120px;margin:0 auto;isolation:isolate}
  .event-print{position:absolute;padding:8px 8px 16px;background:#faf8f1;box-shadow:0 12px 29px #302c2252;transition:transform .25s ease}
  .event-print img{width:100%;height:100%;object-fit:cover}
  .event-print--talk{width:39%;height:42%;left:2%;top:3%;transform:rotate(-4deg);z-index:2}
  .event-print--movie{width:39%;height:40%;right:2%;top:2%;transform:rotate(4deg);z-index:1}
  .event-print--buffet{width:38%;height:43%;left:29%;top:25%;transform:rotate(2deg);z-index:4}
  .event-print--dinner{width:28%;height:46%;left:1%;bottom:1%;transform:rotate(4deg);z-index:5}
  .event-print--detail{width:30%;height:35%;right:4%;bottom:1%;transform:rotate(-3deg);z-index:6}
  .event-print--dinner img{object-position:50% 58%}
  .event-print--detail img{object-position:50% 63%}
  .event-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,5rem)}
  .event-grid article{border-top:2px solid var(--forest);padding-top:1.5rem}
  @media(max-width:800px){.event-showcase{grid-template-columns:1fr}.event-feature{margin:0}.event-feature img{height:auto;aspect-ratio:3/2}.event-wall{height:620px}}
  @media(max-width:600px){.event-grid{grid-template-columns:1fr}.event-wall{height:720px}.event-print{padding:5px 5px 10px}.event-print--talk{width:62%;height:29%;left:0;top:1%}.event-print--movie{width:62%;height:26%;right:0;top:17%}.event-print--buffet{width:61%;height:27%;left:2%;top:37%}.event-print--dinner{width:45%;height:30%;left:0;bottom:0}.event-print--detail{width:42%;height:22%;right:0;left:auto;bottom:0}}
  @media(prefers-reduced-motion:reduce){.event-print{transition:none}}
</style>
