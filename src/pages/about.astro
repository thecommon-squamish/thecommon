---
import Base from '../layouts/Base.astro';
---
<Base current="about" title="About The Common — Coworking in Squamish" description="Get to know The Common, a welcoming coworking space in downtown Squamish.">
  <header class="page-hd">
    <div class="mesh" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow on-dark">About The Common</span>
      <h1>Space to work. <em class="shimmer">People to meet.</em></h1>
      <p>The Common is a coworking space in downtown Squamish. Come to focus, stay to connect.</p>
    </div>
  </header>

  <section class="section light">
    <div class="wrap split">
      <img class="photo" src="/img/common/photo-2.jpg" alt="Desks and plants inside The Common" />
      <div>
        <span class="eyebrow">The space</span>
        <h2>Come as you are.</h2>
        <p>Whether you need a desk for an hour, a day, or every week, The Common gives you a welcoming place to get things done alongside other people.</p>
        <div class="actions">
          <a class="btn btn-ink" href="/day-pass/">Book a desk</a>
          <a class="text-link" href="/membership/">See memberships →</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 1rem 0; }
  p { color: var(--stone); font-size: 1.08rem; margin-bottom: 1.7rem; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.3rem; }
  .text-link { text-decoration: underline; text-underline-offset: 4px; font-weight: 500; }
</style>
