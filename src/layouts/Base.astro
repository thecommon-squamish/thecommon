---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'The Common | Coworking in Squamish',
  description = 'Book a desk or private room at The Common, a coworking space and community in downtown Squamish.',
  current = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isPreview = import.meta.env.PUBLIC_SITE_PREVIEW === 'true';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {isPreview && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  {!isPreview && <script async src="https://www.googletagmanager.com/gtag/js?id=G-L9RSCHQ4KG"></script>}
  {!isPreview && <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-L9RSCHQ4KG');
  </script>}

</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Nav current={current} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

</body>
</html>
