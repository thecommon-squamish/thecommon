---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/footer.css';
import '../styles/keyboard.css';
import '../styles/theme.css';

const {
  title = 'The Common | Coworking in Squamish',
  description = 'Book a desk or private room at The Common, a coworking space and community in downtown Squamish.',
  current = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isPreview = import.meta.env.PUBLIC_SITE_PREVIEW === 'true';
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'The Common',
  url: 'https://www.thecommon.io/',
  image: 'https://www.thecommon.io/img/approved/main-workspace.jpg',
  telephone: '+1-778-906-0405',
  email: 'welcome@thecommon.io',
  address: { '@type': 'PostalAddress', streetAddress: '38016 Cleveland Avenue', addressLocality: 'Squamish', addressRegion: 'BC', addressCountry: 'CA' },
  sameAs: ['https://www.instagram.com/thecommon.io/', 'https://www.facebook.com/thecommon.io/'],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {isPreview && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://www.thecommon.io/img/approved/main-workspace.jpg" />
  {current === 'home' && <script type="application/ld+json" is:inline set:html={JSON.stringify(business)} />}

  {!isPreview && <script async src="https://www.googletagmanager.com/gtag/js?id=G-L9RSCHQ4KG"></script>}
  {!isPreview && <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-L9RSCHQ4KG');
    document.addEventListener('click', function (event) {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest('a[href*="e-commerce.officernd.com"]');
      if (!link) return;
      gtag('event', 'booking_click', {
        booking_label: link.textContent.trim(),
        page_path: window.location.pathname,
      });
    });
  </script>}

</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Nav current={current} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

</body>
</html>
