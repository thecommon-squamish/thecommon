---
import { privateOfficeAvailability } from '../data/officeAvailability';

const isAvailable = privateOfficeAvailability === 'available';
const email = 'mailto:welcome@thecommon.io?subject=Monthly%20private%20office%20at%20The%20Common';
---
<section class="private-office-section" id="private-office" aria-labelledby="private-office-title">
  <div class="wrap private-office-layout">
    <div class="private-office-photo">
      <img src="/img/approved/private-office.jpg" alt="One of the monthly private offices at The Common, furnished with a desk and chair" loading="lazy" />
    </div>
    <div class="private-office-copy">
      <span class="kicker">Monthly private offices</span>
      <h2 id="private-office-title">A workspace of your own.</h2>
      <p>Settle into a private workspace and make it your own. Our offices are rented by the month, with the shared spaces and community of The Common close by.</p>
      <p class="office-availability" data-office-availability={privateOfficeAvailability}>
        <span class="availability-dot" aria-hidden="true"></span>
        {isAvailable ? 'Available now' : 'Ask us about current availability'}
      </p>
      <p class="office-availability-note">We confirm openings, terms, and pricing directly with you.</p>
      <a class="btn btn-primary" href={email}>{isAvailable ? 'Ask about an office' : 'Check monthly availability'}</a>
    </div>
  </div>
</section>

<style>
  .private-office-section{padding:clamp(4rem,7vw,6rem) 0;background:#e7ece6}
  .private-office-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(2rem,5vw,5rem);align-items:center}
  .private-office-photo{padding:10px;background:#fff;box-shadow:16px 17px 0 #c6d2c7,0 24px 42px #17342427;transform:rotate(-.8deg)}
  .private-office-photo img{width:100%;height:auto;display:block}
  .private-office-copy h2{font-size:clamp(2.3rem,4vw,4rem);line-height:1.04;letter-spacing:-.045em;margin:.75rem 0 1.2rem}
  .private-office-copy>p:not(.office-availability){font-size:1.06rem;color:var(--muted);max-width:35rem}
  .office-availability{display:flex;align-items:center;gap:.65rem;font-weight:700;color:var(--forest-deep);margin:1.6rem 0 .25rem}
  .availability-dot{display:inline-block;width:.75rem;height:.75rem;border-radius:50%;background:#d08b5f;box-shadow:0 0 0 4px #d08b5f30}
  [data-office-availability=available] .availability-dot{background:#27855d;box-shadow:0 0 0 4px #27855d30}
  .office-availability-note{font-size:.9rem!important;margin-bottom:1.5rem}
  @media(max-width:760px){.private-office-layout{grid-template-columns:1fr}.private-office-photo{transform:none}.private-office-copy{padding-top:1rem}}
</style>
