---
const { current = '' } = Astro.props;
const links = [
  { href: '/spaces/', label: 'Rooms', key: 'spaces' },
  { href: '/day-pass/', label: 'Desks', key: 'day-pass' },
  { href: '/membership/', label: 'Memberships', key: 'membership' },
  { href: '/event-space/', label: 'Events', key: 'event-space' },
  { href: '/about/', label: 'Our story', key: 'about' },
  { href: '/faq/', label: 'FAQs', key: 'faq' },
  { href: '/contact/', label: 'Contact', key: 'contact' },
];
---
<nav class="nav" aria-label="Primary">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="The Common home">
      <img src="/img/logo-white.png" alt="The Common Squamish" />
    </a>
    <ul class="nav-menu">
      {links.map((l) => (
        <li><a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <a class="nav-cta" href="/spaces/"><span class="nav-cta-full">Book a space</span><span class="nav-cta-short">Book</span></a>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-label={l.label} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </details>
  </div>
</nav>
