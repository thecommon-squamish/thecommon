---
const { current = '' } = Astro.props;
const groups = [
  { label: 'Workspaces', links: [
    { href: '/spaces/', label: 'Rooms', key: 'spaces' },
    { href: '/day-pass/', label: 'Desks', key: 'day-pass' },
    { href: '/membership/#private-office', label: 'Private offices', key: 'offices' },
    { href: '/membership/', label: 'Memberships', key: 'membership' },
  ] },
  { label: 'Community', links: [
    { href: '/event-space/', label: 'Events', key: 'event-space' },
    { href: '/about/', label: 'Our story', key: 'about' },
    { href: '/community/', label: 'Community', key: 'community' },
  ] },
  { label: 'Help', links: [
    { href: '/faq/', label: 'FAQs', key: 'faq' },
    { href: '/contact/', label: 'Contact', key: 'contact' },
  ] },
];
---
<nav class="nav" aria-label="Primary">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="The Common home">
      <img src="/img/logo-white.png" alt="The Common Squamish" />
    </a>
    <ul class="nav-menu">
      {groups.map((group) => (
        <li><details class="nav-group"><summary>{group.label}</summary><div class="nav-submenu">
          {group.links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
        </div></details></li>
      ))}
    </ul>
    <a class="nav-cta" href="/spaces/"><span class="nav-cta-full">Book a space</span><span class="nav-cta-short">Book</span></a>
    <details class="mobile-menu">
      <summary>Menu</summary>
      <ul>
        {groups.map((group) => (
          <li class="mobile-menu-group"><span>{group.label}</span>
            {group.links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
          </li>
        ))}
      </ul>
    </details>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const groups = Array.from(nav?.querySelectorAll<HTMLDetailsElement>('.nav-group') ?? []);
  const mobileMenu = nav?.querySelector<HTMLDetailsElement>('.mobile-menu');

  const closeGroups = (except?: HTMLDetailsElement) => {
    groups.forEach((group) => {
      if (group !== except) group.open = false;
    });
  };

  groups.forEach((group) => {
    const trigger = group.querySelector('summary');
    if (!trigger) return;

    group.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      closeGroups(group);
      group.open = true;
    });

    group.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') group.open = false;
    });

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      const pointerType = event instanceof PointerEvent ? event.pointerType : '';
      const toggle = pointerType !== 'mouse';
      const wasOpen = group.open;
      closeGroups(group);
      group.open = toggle ? !wasOpen : true;
    });

    group.addEventListener('focusout', (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) group.open = false;
    });
  });

  document.addEventListener('pointerdown', (event) => {
    if (!nav?.contains(event.target as Node)) {
      closeGroups();
      if (mobileMenu) mobileMenu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openGroup = groups.find((group) => group.open);
    closeGroups();
    if (mobileMenu?.open) mobileMenu.open = false;
    openGroup?.querySelector('summary')?.focus();
  });

  window.addEventListener('scroll', () => closeGroups(), { passive: true });
</script>
